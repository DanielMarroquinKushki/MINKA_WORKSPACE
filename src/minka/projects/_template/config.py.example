"""
Configuración del proyecto <NOMBRE>.

Se fusiona ENCIMA de config.py (global) y DEBAJO de config_local.py (dev):
    global → proyecto → local
Solo constantes en MAYÚSCULAS (mismo contrato que config_loader).
"""

# Repos del proyecto: {alias: ruta}. Rutas RELATIVAS a REPOS_ROOT (la carpeta donde cada
# dev clona los repos, definida en su config_local.py); una ruta absoluta se usa tal cual.
# Los alias se usan en las citas (POS/ruta/archivo.go:12) y en las tools (list_repos).
REPOS = {
    "pos": "svc-pos",
    "core": "svc-core",
}

# Stack del proyecto (core/stacks.py): "go" | "python" | "node". Comentado = "go" con el
# comportamiento de siempre. Decide extensiones de código, comando de tests, archivo de
# dependencias, knowledge profesional por defecto y qué tools exclusivas de Go se registran.
# STACK = "python"

# Cumplimiento opcional: habilita check_pci_compliance y la checklist PCI en el knowledge.
# Comentado = ["pci"] solo si STACK también está comentado (esquema viejo); con STACK, [].
# COMPLIANCE = ["pci"]

# Módulo compartido cuya versión se compara entre repos (check_version_drift; solo Go).
CORE_MODULE_NAME = "<modulo-core>"

# Checklist de cada descripción de PR.
PR_CHECKLIST = [
    "Cumple convenciones del repo",
    "Sin secretos/llaves hardcodeadas",
    "Tests actualizados",
]

# Pilares del equipo (ver knowledge/team/team_pillars.md). Vacíos = se omiten.
# TEAM_PILLARS = ["  01 Nombre del pilar — ¿pregunta de control?"]
# TEAM_PILLARS_HEADING = "Pilares del equipo"
# TEAM_PILLARS_READABILITY = ""
# TEAM_PILLARS_LINE_CAP_HINT = ""

# Knowledge por agente (rutas relativas a knowledge/ del proyecto; si un doc
# no existe en el proyecto, se busca en core/knowledge/ como fallback).
# Un agente que NO aparece aquí recibe los defaults del STACK (core/stacks.py):
# hexagonal + patrones para architecture; checklist (+ go_best_practices si STACK=go,
# + pci_checklist si "pci" en COMPLIANCE) + pilares para development y pr_review.
# Declara un agente con [] para dejarlo sin knowledge.
AGENT_KNOWLEDGE = {
    "debug_agent": [],
    "report_agent": [],
    "meta_agent": [],
    # "architecture_agent": ["professional/hexagonal_architecture.md", "extracted/architecture.md"],
}

# Tools permitidas por agente. Seguridad por diseño: solo development_agent
# accede a escritura/git de commit.
AGENT_TOOLS = {
    "architecture_agent": [
        "read_file", "scan_directory", "list_files", "grep_code", "find_interface",
        "find_usages", "parse_interfaces", "detect_patterns", "check_core_version",
        "map_dependencies", "check_version_drift", "detect_risks",
    ],
    "development_agent": [
        "read_file", "scan_directory", "grep_code", "find_interface", "find_usages",
        "parse_interfaces", "write_file", "apply_diff", "create_branch", "show_diff",
        "current_branch", "git_log", "commit_change", "detect_risks",
    ],
    "pr_review_agent": [
        "read_file", "show_diff", "git_log", "validate_diff", "create_pr_description",
        "grep_code", "find_usages", "detect_risks", "check_pci_compliance", "check_version_drift",
    ],
    "debug_agent": [
        "read_file", "grep_code", "find_interface", "find_usages", "scan_directory",
        "git_log", "detect_patterns",
    ],
    "report_agent": [
