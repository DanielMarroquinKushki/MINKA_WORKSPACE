# Copia a .env y completa. El .env está en .gitignore — nunca lo commitees.

# API key de Anthropic (requerida SOLO en modo API directa).
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: override del modelo por defecto.
# ANTHROPIC_MODEL=claude-opus-4-8

# --- Backend LLM (modo dual: Anthropic directo / Amazon Bedrock vía SSO) ---
# IMPORTANTE: si tienes AWS_PROFILE exportado en tu shell (~/.zshrc o ~/.bashrc)
# el agente usará Bedrock automáticamente con ese perfil.
# Para forzar API directa de Anthropic:
# export LLM_BACKEND=anthropic
# Para usar Bedrock con el perfil correcto:
# export AWS_PROFILE=bedrock
LLM_BACKEND=
AWS_PROFILE=bedrock
AWS_REGION=us-east-1